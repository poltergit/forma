# Public Supabase project configuration.
# Keep local, preview, and production projects isolated.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used only for absolute links in email flows and canonical metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never expose a service-role key to the browser. The MVP should not need one.
# SUPABASE_SERVICE_ROLE_KEY=
